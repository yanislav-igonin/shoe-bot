{
  "name": "shoe-bot",
  "description": "",
  "version": "1.0.0",
  "main": "index.js",
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "volta": {
    "node": "22.23.1"
  },
  "scripts": {
    "benchmark:images": "tsx -r dotenv/config src/scripts/image-generation-benchmark.ts",
    "dev": "nodemon --watch 'src/**/*.*' --exec 'tsx -r dotenv/config -r tsconfig-paths/register src/index.ts'",
    "lint": "eslint --ext .ts src",
    "test": "tsx --test src/**/*.test.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json && tsc-alias -p tsconfig.build.json",
    "start": "node dist/index.js",
    "migration:baseline": "tsx -r dotenv/config src/scripts/baseline-migration.ts",
    "migration:down": "mikro-orm migration:down",
    "migration:status": "mikro-orm migration:list",
    "migration:up": "mikro-orm migration:up"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yanislav-igonin/shoe-bot.git"
  },
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/yanislav-igonin/shoe-bot/issues"
  },
  "mikro-orm": {
    "configPaths": [
      "./src/mikro-orm.config.ts",
      "./dist/mikro-orm.config.js"
    ]
  },
  "homepage": "https://github.com/yanislav-igonin/shoe-bot#readme",
  "devDependencies": {
    "@mikro-orm/cli": "^7.1.7",
    "@types/luxon": "^3.3.7",
    "@typescript-eslint/parser": "^5.53.0",
    "dotenv": "^16.0.3",
    "eslint": "8.34.0",
    "eslint-config-canonical": "^40.0.7",
    "nodemon": "^2.0.20",
    "ts-node": "^10.9.1",
    "tsc-alias": "^1.8.2",
    "tsconfig-paths": "^4.1.2",
    "typescript": "^5.8.3"
  },
  "dependencies": {
    "@ai-sdk/xai": "^4.0.18",
    "@mikro-orm/core": "^7.1.7",
    "@mikro-orm/decorators": "^7.1.7",
    "@mikro-orm/migrations": "^7.1.7",
    "@mikro-orm/postgresql": "^7.1.7",
    "ai": "^7.0.37",
    "grammy": "^1.14.1",
    "luxon": "^3.4.4",
    "openai": "^4.16.1",
    "reflect-metadata": "^0.2.2",
    "together-ai": "^0.44.0",
    "tsx": "^4.23.1",
    "zod": "^4.4.3"
  }
}
